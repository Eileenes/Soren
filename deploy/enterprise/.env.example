# Public domain; use a domain you control, without https:// or a path.
SOREN_ENTERPRISE_DOMAIN=soren.example.com
ENTERPRISE_NAME=公司空间

# Generate independent values locally; never commit .env.
# POSTGRES_PASSWORD: openssl rand -hex 32 (hex avoids URL escaping in DATABASE_URL).
POSTGRES_PASSWORD=replace-with-random-hex
# ENTERPRISE_VAULT_KEY: openssl rand -base64 32. Back this up separately.
ENTERPRISE_VAULT_KEY=replace-with-base64-32-byte-key

# oauth (default) for standalone deployments; ingresshub for company platform SSO.
# In ingresshub mode the OAuth settings below are unused; see docs/INGRESSHUB-DEPLOYMENT.md.
ENTERPRISE_AUTH_MODE=oauth

# Register https://YOUR_DOMAIN/auth/callback with the company IdP.
# This implementation requires authorization code + PKCE S256 + UserInfo.
ENTERPRISE_AUTHORIZATION_URL=https://idp.example.com/oauth2/auth
ENTERPRISE_TOKEN_URL=https://idp.example.com/oauth2/token
ENTERPRISE_USERINFO_URL=https://idp.example.com/userinfo
ENTERPRISE_CLIENT_ID=replace-with-registered-client-id
ENTERPRISE_CLIENT_SECRET=replace-with-server-only-client-secret
ENTERPRISE_AUTH_METHOD=client_secret_basic
ENTERPRISE_SCOPE=openid profile email
# Use the documented immutable identity field: usually sub; some company IdPs use id.
ENTERPRISE_SUBJECT_CLAIM=sub
# Comma-separated stable subject IDs for a pilot.
# Set * only if the IdP application already restricts authorization to eligible employees.
ENTERPRISE_ALLOWED_SUBJECTS=replace-with-pilot-employee-subject-ids

# Configure one model provider. Employees do not receive these keys.
SOREN_MODEL=replace-with-your-model-id
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ENTERPRISE_MODEL_CONCURRENCY=8
