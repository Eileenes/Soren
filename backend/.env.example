# 服务器配置
SERVER_HOST=127.0.0.1
SERVER_PORT=8080

# 数据目录（桌面端默认 ~/.soren）
SOREN_DATA_DIR=

# 存储配置：sqlite（默认，零配置）| postgres
STORAGE_DRIVER=sqlite
SQLITE_PATH=
DATABASE_URL=postgres://postgres:postgres@localhost:5432/soren?sslmode=disable

# 缓存配置：memory（默认，无需 Redis）| redis
CACHE_DRIVER=memory
REDIS_URL=localhost:6379

# 长期记忆系统
MEMORY_ENABLED=true
MEMORY_RECALL_LIMIT=10

# OpenAI 配置
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic 配置
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_BASE_URL=https://api.anthropic.com

# ============ 消息渠道（可选，默认关闭，未配置不影响服务启动）============

# 飞书渠道
# 在飞书开放平台创建自建应用，开通「机器人」能力并订阅 im.message.receive_v1 事件。
FEISHU_ENABLED=false
FEISHU_APP_ID=your_feishu_app_id
FEISHU_APP_SECRET=your_feishu_app_secret
# 事件订阅的 Verification Token，用于校验事件来源
FEISHU_VERIFICATION_TOKEN=your_verification_token
# 事件订阅的 Encrypt Key，配置后事件为加密推送，同时用于校验回调签名（可选）
# Webhook 模式必填；长连接模式可留空
FEISHU_ENCRYPT_KEY=
# 接入模式：ws=长连接（默认，桌面端/内网无需公网 IP）；webhook=事件订阅（需公网地址）
FEISHU_MODE=ws
# Webhook 模式下的回调地址为 http://<公网地址>:<端口>/webhook/feishu
# 该端口必须与 SERVER_PORT 不同
FEISHU_WEBHOOK_PORT=8081
# 开放平台地址，私有化部署时可修改
FEISHU_BASE_URL=https://open.feishu.cn

# 钉钉渠道
# 在钉钉开放平台创建企业内部应用，添加「机器人」能力并发布。
DINGTALK_ENABLED=false
# 应用的 AppKey / AppSecret（新版控制台称为 ClientID / ClientSecret）
DINGTALK_CLIENT_ID=your_dingtalk_client_id
DINGTALK_CLIENT_SECRET=your_dingtalk_client_secret
# 机器人 RobotCode，通常与应用 AppKey 相同，留空时自动使用 DINGTALK_CLIENT_ID
DINGTALK_ROBOT_CODE=
# 接入模式：ws=Stream 长连接（默认，桌面端/内网无需公网 IP）；webhook=Outgoing Webhook
DINGTALK_MODE=ws
# Webhook 模式下的回调地址为 http://<公网地址>:<端口>/webhook/dingtalk
# 该端口必须与 SERVER_PORT 以及飞书渠道端口都不同
DINGTALK_WEBHOOK_PORT=8082
# 机器人加签密钥，用于校验 Webhook 请求签名（可选）
# Webhook 模式必填；Stream 模式可留空
DINGTALK_WEBHOOK_SECRET=

# 可选：全局默认模型，供聊天、任务与渠道使用；Bot 的独立模型设置优先。
SOREN_MODEL=
